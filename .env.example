# ---------------------------------------------------------------------------
# SiteForge AI — variables d'environnement
# Copier ce fichier en `.env.local` et compléter. Tant que DEMO_MODE=true,
# aucune clé n'est requise : l'application tourne sur des données fictives.
# ---------------------------------------------------------------------------

# Mode démo : aucune API externe n'est appelée, les données sont fictives.
DEMO_MODE=true

# --- Identité de la microentreprise (mentions légales devis/factures) ------
SIREN=000000000
ENTREPRISE_NOM="SiteForge AI"
ENTREPRISE_EXPLOITANT="Axel S."
ENTREPRISE_ADRESSE="37260 Monts, Centre-Val de Loire, France"
ENTREPRISE_EMAIL=contact@siteforge.ai
ENTREPRISE_TELEPHONE="+33 0 00 00 00 00"

# --- Authentification mono-utilisateur + 2FA -------------------------------
AUTH_EMAIL=contact@siteforge.ai
# Hash scrypt du mot de passe : `node scripts/hash-password.mjs "monMotDePasse"`
AUTH_PASSWORD_HASH=
# Secret TOTP base32 (Google Authenticator) : `node scripts/totp-secret.mjs`
AUTH_TOTP_SECRET=
# Secret de signature du cookie de session (32+ caractères aléatoires)
SESSION_SECRET=dev-session-secret-change-me-please-32chars

# --- Base de données PostgreSQL (Supabase) ---------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/siteforge

# --- Génération de sites (API Claude) --------------------------------------
# Alternative économique : claude-haiku-4-5 (1 $ / 5 $ par MTok)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Recherche / veille ----------------------------------------------------
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
# API Recherche d'entreprises (SIRENE) — publique, sans clé
SIRENE_API_URL=https://recherche-entreprises.api.gouv.fr

# --- Hébergement automatisé ------------------------------------------------
VERCEL_TOKEN=
VERCEL_TEAM_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ROOT_DOMAIN=siteforge.ai

# --- Facturation -----------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Emailing (opt-out B2B RGPD) -------------------------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=
BREVO_API_KEY=
EMAIL_FROM="SiteForge AI <contact@siteforge.ai>"

# --- Publicité (lecture seule) ---------------------------------------------
META_ADS_TOKEN=
META_ADS_ACCOUNT_ID=
GOOGLE_ADS_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# --- Alertes temps réel (optionnel) ----------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# --- Application -----------------------------------------------------------
APP_BASE_URL=http://localhost:3000
